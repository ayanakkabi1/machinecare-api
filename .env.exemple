PORT=5000
NODE_ENV=development

# Base de données MongoDB
MONGO_URI=mongodb://mongo:27017/machinecare

# Authentification & Sécurité
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1d

# Compte utilisateur initial (Seeding)
INITIAL_USER_NAME=Default User
INITIAL_USER_EMAIL=user@machinecare.com
INITIAL_USER_PASSWORD=UserPassword123!
