# Copier ce fichier en .env puis remplacer les valeurs (ne jamais committer .env)
PORT=5000
NODE_ENV=development

# Base de données MongoDB ("mongo" = nom du service Docker Compose)
MONGO_URI=mongodb://mongo:27017/machinecare

# Authentification JWT : utiliser une longue chaîne aléatoire (ex. `openssl rand -hex 32`)
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# Compte créé au premier démarrage (valeurs de démo utilisées par la collection Postman : à changer en production)
INITIAL_USER_NAME=Default User
INITIAL_USER_EMAIL=user@machinecare.com
INITIAL_USER_PASSWORD=UserPassword123!
